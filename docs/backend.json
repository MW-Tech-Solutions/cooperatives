
{
  "entities": {
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global configuration for the cooperative society.",
      "type": "object",
      "properties": {
        "minMonthlyContribution": { "type": "number", "description": "Minimum allowed monthly contribution." },
        "defaultPenaltyRate": { "type": "number", "description": "Percentage penalty for late payments." },
        "loanToSavingsMultiplier": { "type": "number", "description": "Maximum loan amount as a multiple of savings." },
        "emergencyLoanInterest": { "type": "number", "description": "Interest rate for emergency loans." },
        "loanEligibilityMonths": { "type": "number", "description": "Months of contribution required for loan eligibility." },
        "autoDebitDate": { "type": "number", "description": "Day of the month for auto-debits." },
        "paystackPublicKey": { "type": "string", "description": "Paystack API Public Key." },
        "paystackSecretKey": { "type": "string", "description": "Paystack API Secret Key." },
        "isAutoDebitActive": { "type": "boolean" },
        "branding": {
          "type": "object",
          "properties": {
            "systemName": { "type": "string" },
            "logoUrl": { "type": "string" }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "number" },
            "user": { "type": "string" },
            "pass": { "type": "string" },
            "fromName": { "type": "string" },
            "fromEmail": { "type": "string" }
          }
        }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended information for society members.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["PRESIDENT", "ASSISTANT_PRESIDENT", "SECRETARY_GENERAL", "TREASURER", "AUDITOR", "MEMBER"] },
        "memberId": { "type": "string" },
        "totalSavings": { "type": "number" },
        "joinDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Active", "Pending", "Inactive"] },
        "paystackAuthCode": { "type": "string", "description": "Stored token for recurring billing." }
      }
    },
    "Loan": {
      "title": "Loan Application",
      "description": "Records of member loan requests and status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "memberName": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["AWAITING_APPROVAL", "DISBURSED", "REJECTED", "PAID"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Contribution": {
      "title": "Contribution",
      "description": "Records of financial contributions from members.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable trail of system events.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/settings/global": {
      "schema": "#/entities/SystemSettings",
      "description": "The global system configuration."
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Member profiles."
    },
    "/loans/{loanId}": {
      "schema": "#/entities/Loan",
      "description": "Member loan records."
    },
    "/contributions/{contributionId}": {
      "schema": "#/entities/Contribution",
      "description": "History of all financial transactions."
    },
    "/auditLogs/{logId}": {
      "schema": "#/entities/AuditLog",
      "description": "System event logs."
    }
  }
}
